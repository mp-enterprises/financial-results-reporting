# =============================================================================
# Zmienne środowiskowe dla integracji inFakt API v3.
# Skopiuj do .env i uzupełnij (plik .env nie jest commitowany).
# =============================================================================

# Klucz API inFakt (Ustawienia -> Integracje -> API w panelu inFakt).
# WYMAGANE zakresy: api:invoices:read, api:costs:read, api:accounting:read
INFAKT_API_KEY=

# "sandbox" (https://api.sandbox-infakt.pl) do testów, "production" do danych realnych.
INFAKT_ENV=sandbox

# Katalog, do którego zapisywane są pobrane dane (tworzony automatycznie).
INFAKT_OUTPUT_DIR=./data

# Ile razy ponowić zapytanie po odpowiedzi 429 (limit zapytań), zanim się poddamy.
INFAKT_MAX_RETRIES=5

# Timeout pojedynczego zapytania HTTP, w sekundach.
INFAKT_TIMEOUT_S=30

# Lista NIP-ów dostawców do wykluczenia z kosztów, rozdzielona przecinkami.
# Filtrowanie odbywa się po stronie klienta — patrz README.md.
INFAKT_SUPPLIER_DENYLIST_NIP=
