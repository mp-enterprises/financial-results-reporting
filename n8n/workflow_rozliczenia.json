{
  "name": "Rozliczenia partnerskie — odbiór i przetwarzanie",
  "nodes": [
    {
      "parameters": {
        "postProcessAction": "read",
        "downloadAttachments": true,
        "format": "resolved",
        "options": {
          "customEmailConfig": "[\"UNSEEN\"]",
          "forceReconnect": 60
        }
      },
      "id": "imap-trigger",
      "name": "Nowy mail (IMAP)",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [-460, 0],
      "credentials": {
        "imap": {
          "id": "IMAP_SKRZYNKA",
          "name": "Skrzynka rozliczeniowa"
        }
      },
      "notes": "Nasłuchuje nieprzeczytanych wiadomości. Filtrowanie po nadawcy i temacie robimy w kolejnym węźle, żeby móc logować odrzucone maile."
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 5-12 * *"
            }
          ]
        }
      },
      "id": "schedule-kontrola",
      "name": "Kontrola: czy rozliczenie dotarło",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-460, 320],
      "notes": "Codziennie o 9:00 między 5. a 12. dniem miesiąca sprawdza, czy rozliczenie za poprzedni miesiąc jest już w bazie."
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rozliczenie-reczne",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-reczny",
      "name": "Webhook — uruchomienie ręczne",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-460, 160],
      "webhookId": "rozliczenie-reczne",
      "credentials": {
        "httpHeaderAuth": {
          "id": "N8N_WEBHOOK_AUTH",
          "name": "Klucz webhooka"
        }
      },
      "notes": "Pozwala odpalić przetwarzanie z zewnątrz (np. przyciskiem lub curl-em) bez czekania na maila."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "nadawca",
              "leftValue": "={{ $json.from }}",
              "rightValue": "={{ $vars.NADAWCA_ROZLICZEN || 'nikolajuk' }}",
              "operator": { "type": "string", "operation": "contains" }
            },
            {
              "id": "ma-zalacznik",
              "leftValue": "={{ Object.keys($binary || {}).length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filtr",
      "name": "Czy to rozliczenie?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [-240, 0],
      "notes": "Odsiewa maile spoza oczekiwanego nadawcy oraz bez załącznika. Ustaw zmienną NADAWCA_ROZLICZEN w Settings -> Variables."
    },
    {
      "parameters": {
        "jsCode": "// Wybiera pierwszy załącznik .xlsx z maila.\n// Rozliczenie zawsze zawiera dokładnie jeden plik Excel, ale klient pocztowy\n// potrafi doczepić np. podpis graficzny — dlatego filtrujemy po rozszerzeniu.\nconst wynik = [];\n\nfor (const item of $input.all()) {\n  const binarne = item.binary || {};\n  const klucze = Object.keys(binarne);\n\n  const excel = klucze.filter((k) => {\n    const nazwa = (binarne[k].fileName || '').toLowerCase();\n    return nazwa.endsWith('.xlsx') || nazwa.endsWith('.xlsm');\n  });\n\n  if (excel.length === 0) {\n    throw new Error(`Mail \"${item.json.subject}\" nie zawiera załącznika .xlsx — pomijam.`);\n  }\n  if (excel.length > 1) {\n    console.warn(`Znaleziono ${excel.length} plików Excel; biorę pierwszy: ${binarne[excel[0]].fileName}`);\n  }\n\n  const klucz = excel[0];\n  wynik.push({\n    json: {\n      nazwa_pliku: binarne[klucz].fileName,\n      temat: item.json.subject || '',\n      nadawca: item.json.from || '',\n      data_maila: item.json.date || '',\n      message_id: item.json.messageId || item.json.id || '',\n    },\n    binary: { plik: binarne[klucz] },\n  });\n}\n\nreturn wynik;"
      },
      "id": "wyodrebnij",
      "name": "Wyodrębnij załącznik Excel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-20, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://ingest:8000/ingest",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "plik"
            },
            {
              "name": "source",
              "value": "email"
            },
            {
              "name": "source_reference",
              "value": "={{ $json.message_id }} | {{ $json.nadawca }} | {{ $json.data_maila }}"
            }
          ]
        },
        "options": {
          "timeout": 600000,
          "response": { "response": { "neverError": true, "fullResponse": true } },
          "retry": { "retry": { "maxTries": 3, "waitBetweenTries": 15000 } }
        }
      },
      "id": "wyslij-do-api",
      "name": "Prześlij do API ingest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "INGEST_API_KEY",
          "name": "Klucz API ingest (X-API-Key)"
        }
      },
      "notes": "Wywołuje worker po nazwie usługi w sieci Dockera — ruch nie wychodzi na zewnątrz. Timeout 10 min, bo duży plik + dbt."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "typeValidation": "loose", "version": 2 },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.status }}",
                    "rightValue": "processed",
                    "operator": { "type": "string", "operation": "equals" }
                  },
                  {
                    "leftValue": "={{ $json.body.checks_failed }}",
                    "rightValue": 0,
                    "operator": { "type": "number", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "sukces"
            },
            {
              "conditions": {
                "options": { "typeValidation": "loose", "version": 2 },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.status }}",
                    "rightValue": "duplicate",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "duplikat"
            }
          ]
        },
        "fallbackOutput": "extra",
        "options": {}
      },
      "id": "rozgalezienie",
      "name": "Wynik przetwarzania",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [420, 0],
      "notes": "Trzy ścieżki: sukces, duplikat (nic nie robimy), problem (alert)."
    },
    {
      "parameters": {
        "sendTo": "={{ $vars.EMAIL_POWIADOMIEN }}",
        "subject": "=✅ Rozliczenie {{ $json.body.period }} załadowane ({{ $json.body.partner_code }})",
        "emailFormat": "html",
        "message": "=<h2>Rozliczenie przetworzone</h2>\n<table cellpadding=\"6\" style=\"border-collapse:collapse\">\n<tr><td><b>Partner</b></td><td>{{ $json.body.partner_code }}</td></tr>\n<tr><td><b>Okres</b></td><td>{{ $json.body.period }}</td></tr>\n<tr><td><b>Plik</b></td><td>{{ $json.body.file_name }}</td></tr>\n<tr><td><b>Pozycji sprzedaży</b></td><td>{{ $json.body.rows_sales }}</td></tr>\n<tr><td><b>Pozycji magazynu</b></td><td>{{ $json.body.rows_stock }}</td></tr>\n<tr><td><b>Kontrole kwot</b></td><td>{{ $json.body.checks_total }} / wszystkie zdane</td></tr>\n<tr><td><b>Transformacje dbt</b></td><td>{{ $json.body.dbt_status }}</td></tr>\n</table>\n<p>Dashboard: <a href=\"https://{{ $vars.METABASE_URL }}\">{{ $vars.METABASE_URL }}</a></p>",
        "options": {}
      },
      "id": "powiadom-ok",
      "name": "Powiadom: sukces",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [680, -140],
      "credentials": {
        "smtp": { "id": "SMTP", "name": "Poczta wychodząca" }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $vars.EMAIL_POWIADOMIEN }}",
        "subject": "=⚠️ PROBLEM z rozliczeniem — wymaga sprawdzenia",
        "emailFormat": "html",
        "message": "=<h2 style=\"color:#b00\">Rozliczenie wymaga uwagi</h2>\n<p><b>Status:</b> {{ $json.body.status }}</p>\n<p><b>Plik:</b> {{ $json.body.file_name }}</p>\n<p><b>Okres:</b> {{ $json.body.period }}</p>\n<p><b>Komunikat:</b> {{ $json.body.message }}</p>\n<p><b>Nieudane kontrole kwot:</b> {{ $json.body.checks_failed }}</p>\n<pre style=\"background:#f4f4f4;padding:12px\">{{ JSON.stringify($json.body.failed_checks, null, 2) }}</pre>\n<p>Plik jest zachowany w archiwum. Po wyjaśnieniu rozbieżności z nadawcą\nmożna wgrać poprawioną wersję ręcznie — utworzy nową rewizję.</p>",
        "options": {}
      },
      "id": "powiadom-blad",
      "name": "Powiadom: problem",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [680, 140],
      "credentials": {
        "smtp": { "id": "SMTP", "name": "Poczta wychodząca" }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Czy rozliczenie za poprzedni miesiąc jest już w bazie?\nSELECT\n    to_char(date_trunc('month', now() - interval '1 month'), 'YYYY-MM') AS oczekiwany_okres,\n    EXISTS (\n        SELECT 1\n          FROM core.settlement s\n          JOIN core.period p USING (period_id)\n         WHERE s.is_current\n           AND p.period_year  = extract(year  from now() - interval '1 month')\n           AND p.period_month = extract(month from now() - interval '1 month')\n    ) AS juz_jest;",
        "options": {}
      },
      "id": "sprawdz-brak",
      "name": "Sprawdź czy brakuje rozliczenia",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-240, 320],
      "credentials": {
        "postgres": { "id": "POSTGRES_ROZLICZENIA", "name": "Baza rozliczeń" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.juz_jest }}",
              "rightValue": "false",
              "operator": { "type": "boolean", "operation": "false", "singleValue": true }
            }
          ]
        },
        "options": {}
      },
      "id": "if-brak",
      "name": "Brakuje?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-20, 320]
    },
    {
      "parameters": {
        "sendTo": "={{ $vars.EMAIL_POWIADOMIEN }}",
        "subject": "=⏰ Brak rozliczenia za {{ $json.oczekiwany_okres }}",
        "emailFormat": "html",
        "message": "=<p>Do systemu nie wpłynęło jeszcze rozliczenie za okres <b>{{ $json.oczekiwany_okres }}</b>.</p>\n<p>Jeśli mail dotarł, ale nie został przetworzony, sprawdź zakładkę Executions w n8n\nlub wgraj plik ręcznie przez formularz.</p>",
        "options": {}
      },
      "id": "powiadom-brak",
      "name": "Powiadom: brak rozliczenia",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [200, 320],
      "credentials": {
        "smtp": { "id": "SMTP", "name": "Poczta wychodząca" }
      }
    }
  ],
  "connections": {
    "Nowy mail (IMAP)": {
      "main": [[{ "node": "Czy to rozliczenie?", "type": "main", "index": 0 }]]
    },
    "Webhook — uruchomienie ręczne": {
      "main": [[{ "node": "Czy to rozliczenie?", "type": "main", "index": 0 }]]
    },
    "Czy to rozliczenie?": {
      "main": [[{ "node": "Wyodrębnij załącznik Excel", "type": "main", "index": 0 }]]
    },
    "Wyodrębnij załącznik Excel": {
      "main": [[{ "node": "Prześlij do API ingest", "type": "main", "index": 0 }]]
    },
    "Prześlij do API ingest": {
      "main": [[{ "node": "Wynik przetwarzania", "type": "main", "index": 0 }]]
    },
    "Wynik przetwarzania": {
      "main": [
        [{ "node": "Powiadom: sukces", "type": "main", "index": 0 }],
        [],
        [{ "node": "Powiadom: problem", "type": "main", "index": 0 }]
      ]
    },
    "Kontrola: czy rozliczenie dotarło": {
      "main": [[{ "node": "Sprawdź czy brakuje rozliczenia", "type": "main", "index": 0 }]]
    },
    "Sprawdź czy brakuje rozliczenia": {
      "main": [[{ "node": "Brakuje?", "type": "main", "index": 0 }]]
    },
    "Brakuje?": {
      "main": [[{ "node": "Powiadom: brak rozliczenia", "type": "main", "index": 0 }], []]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveExecutionProgress": true,
    "timezone": "Europe/Warsaw"
  },
  "tags": [{ "name": "rozliczenia" }]
}
