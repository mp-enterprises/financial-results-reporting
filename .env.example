# =============================================================================
# Zmienne środowiskowe — w Coolify wklej je w zakładce Environment Variables.
# Sekrety generuj poleceniem:  openssl rand -hex 32
# NIE commituj wypełnionego pliku .env do repozytorium.
# =============================================================================

# --- baza danych -------------------------------------------------------------
POSTGRES_DB=settlements
POSTGRES_USER=settlements
POSTGRES_PASSWORD=          # WYMAGANE — długie, losowe
METABASE_DB=metabase

# --- worker ingest -----------------------------------------------------------
# Klucz, którym n8n Cloud uwierzytelnia się w API (nagłówek X-API-Key)
INGEST_API_KEY=             # WYMAGANE — openssl rand -hex 32
# Dostęp do formularza ręcznego uploadu i endpointów podglądowych (Basic Auth)
ADMIN_USER=admin
ADMIN_PASSWORD=             # WYMAGANE
RECON_TOLERANCE=0.01        # tolerancja rekoncyliacji w PLN
MAX_UPLOAD_MB=50

# --- konto tylko-do-odczytu dla Metabase -------------------------------------
# Po pierwszym uruchomieniu ustaw hasło roli metabase_ro:
#   ALTER ROLE metabase_ro PASSWORD 'twoje_haslo';
METABASE_RO_PASSWORD=

# --- kopie zapasowe ----------------------------------------------------------
BACKUP_RETENTION_DAYS=30

# =============================================================================
# DOMENY: nie ustawiamy ich tutaj. W Coolify wpisujesz je w polu "Domains"
# przy każdej usłudze, razem z portem kontenera:
#     metabase  ->  https://bi.twojadomena.pl:3000
#     ingest    ->  https://rozliczenia.twojadomena.pl:8000
# Szczegóły w runbooku, krok 04.
#
# n8n: używamy n8n Cloud — nie ma go w tym stacku, więc nie ma tu jego zmiennych.
# =============================================================================
